# Example environment variable configuration file for SIMONE.
# Copy this file to .env and fill in the required values before starting the application.

# Neo4j configuration
NEO4J_HOSTNAME=
NEO4J_PORT=7687
NEO4J_USER=neo4j
# WARNING: NEO4J_PASSWORD is only applied when the Neo4j data directory is initialized.
# Changing it later does not change the persisted database password.
# Either update the password inside Neo4j or reset/restore the Neo4j data directory.
NEO4J_PASSWORD=12345678

# Ollama configuration
OLLAMA_HOSTNAME=
OLLAMA_PORT=11433
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=gemma4:31b-cloud
OLLAMA_CHAT_TOKENIZER=
OLLAMA_EMBED_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
MAX_CONTEXT_LENGTH=8192

# Ollama host/server settings. docker-compose uses these for the local Ollama
# container. For remote Ollama, change equivalent settings on the remote host.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# Runtime embedding request setting: -1=auto, 0=CPU only, >0=GPU layers.
OLLAMA_EMBED_NUM_GPU=-1

# Frontend configuration
FRONTEND_PORT=3000

# Nginx proxy target for the frontend container.
# Use http://api:8000 when API runs in Docker alongside frontend.
# Use http://host.docker.internal:8000 when API runs natively on the host.
API_PROXY_TARGET=http://api:8000

# Runtime configuration
RUNTIME_DIR=./.runtime

